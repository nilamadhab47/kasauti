# Copy to .env and fill in. Never commit .env.

# Bolna (Dashboard → Developers → API Keys)
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai

# Safety: scripts refuse to dial any number not listed here (comma-separated E.164)
ALLOWED_NUMBERS=+91XXXXXXXXXX,+91YYYYYYYYYY

# Your own mobile (Test A: the uncle calls you)
MY_PHONE_NUMBER=+91XXXXXXXXXX

# Demo target (Sehat Clinic v1) — filled in during Phase 0 Step 3
CLINIC_AGENT_ID=
CLINIC_NUMBER=+91YYYYYYYYYY

# Caller persona — filled in during Phase 0 Step 4
PERSONA_AGENT_ID=

# --- Not needed until after Phase 0 ---
# JEV_URL=
# JEV_API_KEY=
