# Copy to .env and fill in. Never commit .env.

# Bolna. Caller agents use BOLNA_API_KEY. Demo desks use DEMO_BOLNA_API_KEY.
BOLNA_API_KEY=
DEMO_BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai

# Comma-separated E.164 numbers the dialer is allowed to call.
ALLOWED_NUMBERS=+91XXXXXXXXXX

# Demo desk agent ids. Rupeesetu is stored as DEMO_AGENT_ID.
SEHAT_AGENT_ID=
DEMO_AGENT_ID=
SWAAD_AGENT_ID=
NILA_AGENT_ID=
NIVAS_AGENT_ID=
PERSONA_AGENT_ID=

# Jev scores the call. Claude writes the patch block.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_PATCH_MODEL=claude-opus-4-1

# Local Postgres and Redis. On Railway these come from the plugins.
DATABASE_URL=postgres://localhost:5432/kasauti
REDIS_URL=redis://127.0.0.1:6379
WEBHOOK_SECRET=

# Gates. Each stays off until the value is exactly "true".
PATCH_ENABLED=false
NUMBER_SWITCH_ENABLED=false
MAX_CONCURRENT_CALLS=1
DAILY_CALL_CAP=40

# API port. Railway sets PORT. The web app proxies to KASAUTI_API_URL.
PORT=3001
KASAUTI_API_URL=http://127.0.0.1:3001

# Comma-separated browser origins allowed to call the API. Localhost is always allowed.
# WEB_ORIGINS=https://your-app.vercel.app

# Public origin for report links and badges. Do not set this to localhost in production.
NEXT_PUBLIC_SITE_URL=https://kasauti.app
